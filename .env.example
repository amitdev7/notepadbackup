# zenithsui — environment variables for local dev and Vercel Project Settings.
# Copy to `.env.local` for local development. On Vercel, add each key in
# Project Settings → Environment Variables (Production + Preview as needed).
# The app runs without any of these (local-first canvas); each one only
# unlocks its own integration.

# Canonical public URL (used for metadata/canonical links). Vercel provides
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automatically; set this only to
# override, e.g. a custom domain.
# NEXT_PUBLIC_SITE_URL=https://zenithsui.sh

# --- AI providers (server-side; never expose with NEXT_PUBLIC_) ---
# Recommended: powers the Zenith AI assistant out of the box.
# GEMINI_API_KEY=
# Optional BYOK providers (also connectable per-user in Settings → AI vault):
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# PERPLEXITY_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# --- Server secrets ---
# Signs auth cookies / HMAC tokens. Set a long random string in production.
# ZENITHSUI_SECRET_KEY=
# ZENITHSUI_AUTH_SECRET=
# DATABASE_ENCRYPTION_SECRET=
# ENCRYPTION_KEY=

# --- Optional: Supabase cloud storage ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
